# ==========================================
# POWER BI ENTERPRISE HYGIENE & SECURITY
# ==========================================

# 1. Lock & Temporary Files (Prevents Git Corruption)
# Created when a .pbix file is currently open in Power BI Desktop.
~$*.pbix
~$*.pbit
*.pbix.tmp
*.pbit.tmp
*.pbix.lock

# 2. Data Source Connection Files (🚨 CRITICAL SECURITY RISK)
# .pbids files store connection strings, local file paths, server names, 
# and sometimes cached authentication tokens. NEVER commit secrets or local paths.
*.pbids

# 3. Local Analysis Services Workspaces
# If you use Live Connections, DirectQuery, or local tabular models, 
# PBI creates hidden local workspace folders and port files.
AnalysisServicesWorkspace_*/
msmdsrv.port.txt
msmdsrv.ini

# 4. Crash Recovery & Auto-Save Backups
# Generated by PBI Desktop during unexpected crashes or auto-saves.
*.pbix.bak
*.pbix.backup
*.pbit.bak

# 5. Unzipped / Extracted PBIX Artifacts
# Advanced BI developers sometimes unzip .pbix files (which are just ZIP archives)
# to track M-Code (Power Query) or JSON layouts in Git. If you do this, 
# ignore the extracted folders so they don't clutter the main repo.
pbix_extracted/
*.DataMashup
DiagramLayout.json

# 6. OS-Level Image Caches (For your README screenshots)
# When taking screenshots of your dashboard for the README, Windows/Mac 
# generate hidden thumbnail caches. Ignore them.
Thumbs.db
.DS_Store

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
#Pipfile.lock

# celery beat schedule file
celerybeat-schedule

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# Ignore everything inside src/utils.egg-info/
src/utils.egg-info/

# Ignore everything inside data/ and outputs/
data/*
!data/raw/
data/raw/*
models/*
results/*






# But do not ignore the .gitkeep files
!data/.gitkeep*
!data/raw/.gitkeep*
!models/.gitkeep*
!results/.gitkeep*


